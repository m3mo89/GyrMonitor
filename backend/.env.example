NODE_ENV=development
PORT=3000
BACKEND_HOST=127.0.0.1
API_PREFIX=/api/v1
# Comma-separated exact browser origins allowed to call the API.
# Local default if omitted: http://127.0.0.1:5173,http://localhost:5173
# Railway staging example: https://gyr-monitor-staging.vercel.app
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=mysql://gyrmonitor:change-me@localhost:3306/gyrmonitor
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gyrmonitor
DB_USER=gyrmonitor
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10
JWT_SECRET=change-me
JWT_EXPIRES_IN=3600s
PASSWORD_HASH_ITERATIONS=100000
IDEMPOTENCY_TTL_HOURS=24
SYNC_BATCH_SIZE=100
LOG_LEVEL=info
# Enables the Swagger UI at /api/docs and the raw OpenAPI document at /api/docs-json.
# Defaults to enabled outside production; set to false explicitly to disable in any environment.
SWAGGER_ENABLED=true
