{
  "name": "@gyrmonitor/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS-oriented backend foundation for GyrMonitor.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/check-foundation.mjs build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "npm run build && node scripts/migrate-database.mjs",
    "db:seed": "npm run build && node scripts/seed-database.mjs",
    "db:check": "npm run build && node scripts/check-database.mjs",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs",
    "lint": "node scripts/check-foundation.mjs lint",
    "format:check": "node scripts/check-foundation.mjs format",
    "test": "node scripts/check-foundation.mjs test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "typescript": "^5.0.0"
  }
}
