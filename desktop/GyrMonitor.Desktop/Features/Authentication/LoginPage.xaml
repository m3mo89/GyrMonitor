<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyrMonitor.Desktop.Features.Authentication.LoginPage"
             Title="Sign in">

    <ScrollView>
        <Grid Padding="{StaticResource SpacingSection}" VerticalOptions="Center">
            <Border Style="{StaticResource CardStyle}"
                    Padding="{StaticResource SpacingSection}"
                    MaximumWidthRequest="360"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="{StaticResource SpacingDefault}">

                    <Label Text="GyrMonitor" Style="{StaticResource Headline}" />
                    <Label Text="Administrator sign in" Style="{StaticResource SubHeadline}" />

                    <VerticalStackLayout Spacing="{StaticResource SpacingCompact}">
                        <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
                        <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                    </VerticalStackLayout>

                    <Button Text="Sign in"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Fill" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
