<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cattle="clr-namespace:GyrMonitor.Desktop.Core.Features.Cattle;assembly=GyrMonitor.Desktop.Core"
             x:Class="GyrMonitor.Desktop.Features.Cattle.CattlePage"
             Title="Cattle">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Cattle}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="cattle:CattleSummaryDto">
                    <Grid Padding="12" ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0" Text="{Binding TagNumber}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Status}" />
                        <Label Grid.Column="2" Text="{Binding LastRiskScore}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
