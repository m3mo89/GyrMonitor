<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cattle="clr-namespace:GyrMonitor.Desktop.Core.Features.Cattle;assembly=GyrMonitor.Desktop.Core"
             xmlns:controls="clr-namespace:GyrMonitor.Desktop.Shared.Controls"
             xmlns:dstrings="clr-namespace:GyrMonitor.Desktop.Core.Resources.Strings;assembly=GyrMonitor.Desktop.Core"
             x:Class="GyrMonitor.Desktop.Features.Cattle.CattlePage"
             Title="{x:Static dstrings:AppStrings.TabCattle}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <Grid Padding="{StaticResource SpacingDefault}" RowDefinitions="Auto,*" RowSpacing="{StaticResource SpacingCompact}">

            <Label Grid.Row="0"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <controls:EmptyStateView Grid.Row="1"
                                      Glyph="&#128032;"
                                      Title="{x:Static dstrings:AppStrings.NoCattleRecordsTitle}"
                                      Subtitle="{x:Static dstrings:AppStrings.NoCattleRecordsSubtitle}"
                                      IsVisible="{Binding Cattle.Count, Converter={StaticResource IsZeroConverter}}" />

            <CollectionView Grid.Row="1"
                             ItemsSource="{Binding Cattle}"
                             IsVisible="{Binding Cattle.Count, Converter={StaticResource IsZeroConverter}, ConverterParameter=Invert}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cattle:CattleSummaryDto">
                        <Border Style="{StaticResource CardStyle}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingCompact}">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding TagNumber}" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" />
                                    <Label Text="{Binding Breed}" Style="{StaticResource CaptionLabelStyle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource BadgeStyle}"
                                        Stroke="{Binding Status, Converter={StaticResource SeverityToBrushConverter}}"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Status}" Style="{StaticResource BadgeLabelStyle}"
                                           TextColor="{Binding Status, Converter={StaticResource SeverityToBrushConverter}}" />
                                </Border>
                                <Label Grid.Column="2" Text="{Binding LastRiskScore, StringFormat='{0:F1}'}" Style="{StaticResource BodyLabelStyle}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>

</ContentPage>
