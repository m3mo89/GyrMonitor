<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dashboard="clr-namespace:GyrMonitor.Desktop.Core.Features.Dashboard;assembly=GyrMonitor.Desktop.Core"
             xmlns:controls="clr-namespace:GyrMonitor.Desktop.Shared.Controls"
             x:Class="GyrMonitor.Desktop.Features.Dashboard.DashboardPage"
             Title="Dashboard">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="{StaticResource SpacingDefault}" Spacing="{StaticResource SpacingDefault}">

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="{StaticResource SpacingCompact}" RowSpacing="{StaticResource SpacingCompact}"
                      BindingContext="{Binding Metrics}">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Total cattle" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding TotalCattle}" Style="{StaticResource PageTitleStyle}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Active alerts" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding ActiveAlerts}" Style="{StaticResource PageTitleStyle}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="High risk" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding HighRiskCattle}" Style="{StaticResource PageTitleStyle}" TextColor="{StaticResource SeverityHighBrush}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Avg risk" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding AverageRiskScore, StringFormat='{0:F1}'}" Style="{StaticResource PageTitleStyle}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Events today" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding EventsToday}" Style="{StaticResource PageTitleStyle}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Pending sync" Style="{StaticResource CaptionLabelStyle}" />
                            <Label Text="{Binding SyncPendingCount}" Style="{StaticResource PageTitleStyle}" TextColor="{StaticResource StatusPendingBrush}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Risk ranking" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />

                <controls:EmptyStateView Glyph="&#128202;"
                                          Title="No risk data yet"
                                          Subtitle="Risk ranking will appear once cattle events are recorded."
                                          IsVisible="{Binding Metrics.RiskRanking.Count, Converter={StaticResource IsZeroConverter}}" />

                <CollectionView ItemsSource="{Binding Metrics.RiskRanking}"
                                IsVisible="{Binding Metrics.RiskRanking.Count, Converter={StaticResource IsZeroConverter}, ConverterParameter=Invert}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dashboard:RiskRankingItemDto">
                            <Border Style="{StaticResource CardStyle}" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding TagNumber}" Style="{StaticResource BodyLabelStyle}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding RiskScore, StringFormat='{0:F1}'}" Style="{StaticResource BodyLabelStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
