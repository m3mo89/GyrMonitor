<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyrMonitor.Desktop.Features.Sync.SyncPage"
             Title="Synchronization">

    <VerticalStackLayout Padding="16" Spacing="16">

        <Label Text="You are offline. Generated events stay queued until connectivity returns."
               TextColor="OrangeRed"
               IsVisible="{Binding IsOffline}" />

        <Label Text="{Binding PendingCount, StringFormat='Pending items: {0}'}" FontSize="18" />

        <Button Text="Sync now" Command="{Binding SyncNowCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Label Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

    </VerticalStackLayout>

</ContentPage>
