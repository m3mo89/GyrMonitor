<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyrMonitor.Desktop.Shared.Controls.EmptyStateView"
             x:Name="Root">

    <VerticalStackLayout Padding="{StaticResource SpacingSection}"
                          Spacing="{StaticResource SpacingCompact}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">

        <Label Text="{Binding Glyph, Source={x:Reference Root}}"
               FontSize="36"
               TextColor="{StaticResource TextSecondaryBrush}"
               HorizontalOptions="Center" />

        <Label Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource SectionHeaderStyle}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               Style="{StaticResource CaptionLabelStyle}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding Subtitle, Source={x:Reference Root}, Converter={StaticResource StringNotEmptyConverter}}" />

    </VerticalStackLayout>

</ContentView>
