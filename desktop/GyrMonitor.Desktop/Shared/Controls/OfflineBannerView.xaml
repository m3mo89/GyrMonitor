<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyrMonitor.Desktop.Shared.Controls.OfflineBannerView"
             IsVisible="{Binding IsOffline}">

    <Border BackgroundColor="{StaticResource StatusPendingBrush}"
            StrokeThickness="0"
            Padding="{StaticResource SpacingCompact}"
            HorizontalOptions="Fill">
        <Label Text="You're offline. Changes you make will sync automatically once connectivity returns."
               TextColor="{StaticResource White}"
               Style="{StaticResource CaptionLabelStyle}"
               HorizontalTextAlignment="Center" />
    </Border>

</ContentView>
