<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GyrMonitor.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:GyrMonitor.Mobile.Features.Authentication"
    xmlns:alerts="clr-namespace:GyrMonitor.Mobile.Features.Alerts"
    xmlns:sync="clr-namespace:GyrMonitor.Mobile.Features.Sync"
    xmlns:strings="clr-namespace:GyrMonitor.Client.Core.Resources.Strings;assembly=GyrMonitor.Client.Core"
    xmlns:mstrings="clr-namespace:GyrMonitor.Mobile.Core.Resources.Strings;assembly=GyrMonitor.Mobile.Core"
    Title="{x:Static strings:AppStrings.AppName}"
    FlyoutBehavior="Disabled">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label x:Name="PageTitleLabel" Grid.Column="0" VerticalOptions="Center" />
            <Button x:Name="LogoutButton" Grid.Column="1" Text="{x:Static strings:AppStrings.Logout}" Clicked="OnLogoutClicked" VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <ShellContent
        Title="{x:Static mstrings:AppStrings.SignIn}"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="LoginPage" />

    <TabBar Route="Main">
        <ShellContent
            Title="{x:Static mstrings:AppStrings.TabAlerts}"
            ContentTemplate="{DataTemplate alerts:AlertsPage}"
            Route="AlertsPage" />
        <ShellContent
            Title="{x:Static mstrings:AppStrings.TabSync}"
            ContentTemplate="{DataTemplate sync:SyncPage}"
            Route="SyncPage" />
    </TabBar>

</Shell>
