<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GyrMonitor.Mobile.Features.Alerts.AlertDetailPage"
             Title="Alert detail">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <Label Text="Alert was not found in the local cache." IsVisible="{Binding NotFound}" TextColor="Red" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding Alert.TagNumber}" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding Alert.Severity, StringFormat='Severity: {0}'}" />
                <Label Text="{Binding Alert.Status, StringFormat='Status: {0}'}" />
                <Label Text="{Binding Alert.RiskScore, StringFormat='Risk score: {0}'}" />
                <Label Text="{Binding Alert.Reason, StringFormat='Reason: {0}'}" />
                <Label Text="{Binding Alert.CreatedAt, StringFormat='Created at: {0}'}" TextColor="Gray" FontSize="12" />

                <Button Text="Add observation" Clicked="OnAddObservationClicked" Margin="0,16,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
