<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mstrings="clr-namespace:GyrMonitor.Mobile.Core.Resources.Strings;assembly=GyrMonitor.Mobile.Core"
             x:Class="GyrMonitor.Mobile.Features.Alerts.AlertDetailPage"
             Title="{x:Static mstrings:AppStrings.AlertDetailTitle}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <Label Text="{x:Static mstrings:AppStrings.AlertNotFoundInCache}" IsVisible="{Binding NotFound}" TextColor="Red" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding NotFound, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding Alert.TagNumber}" FontSize="22" FontAttributes="Bold" />
                <Label Text="{Binding DisplaySeverity}" />
                <Label Text="{Binding DisplayStatus}" />
                <Label Text="{Binding DisplayRiskScore}" />
                <Label Text="{Binding DisplayReason}" />
                <Label Text="{Binding DisplayCreatedAt}" TextColor="Gray" FontSize="12" />

                <Button Text="{x:Static mstrings:AppStrings.AddObservation}" Clicked="OnAddObservationClicked" Margin="0,16,0,0" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
