<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:GyrMonitor.Client.Core.Resources.Strings;assembly=GyrMonitor.Client.Core"
             xmlns:mstrings="clr-namespace:GyrMonitor.Mobile.Core.Resources.Strings;assembly=GyrMonitor.Mobile.Core"
             x:Class="GyrMonitor.Mobile.Features.Authentication.LoginPage"
             Title="{x:Static mstrings:AppStrings.SignIn}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="{x:Static strings:AppStrings.AppName}" FontSize="28" HorizontalOptions="Center" />
            <Label Text="{x:Static mstrings:AppStrings.FieldOperatorSignInSubtitle}" FontSize="14" HorizontalOptions="Center" TextColor="Gray" />

            <Entry Placeholder="{x:Static mstrings:AppStrings.EmailPlaceholder}" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="{x:Static mstrings:AppStrings.PasswordPlaceholder}" IsPassword="True" Text="{Binding Password}" />

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsEnvironmentPickerVisible}">
                <Label Text="{x:Static strings:AppStrings.EnvironmentLabel}" FontSize="12" TextColor="Gray" />
                <Picker ItemsSource="{Binding AvailableEnvironmentOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedEnvironmentOption}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <Button Text="{x:Static mstrings:AppStrings.SignIn}" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
